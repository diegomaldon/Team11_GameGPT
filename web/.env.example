# Base URL of the GameGPT API. Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_URL=

# Fixture mode: set to 1 to run the frontend standalone with canned data and no
# running API (see web/lib/api/client.ts). Leave empty to hit NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_USE_FIXTURES=

# --- Supabase auth (E2 / REQ001) ---
# Copy this file to web/.env.local and fill both in, or lib/supabase.ts throws on import.
# Dashboard > Project Settings > API. Both values are safe in the browser: the anon key is
# public by design and RLS is what actually protects data. Never put the SERVICE ROLE key
# in a NEXT_PUBLIC_ variable — that one bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Xbox account linking (TM11-53 / REQ014) ---
# Server-only. Never prefix these with NEXT_PUBLIC_. Azure app registration for personal
# Microsoft accounts; see docs/auth-xbox.md. Leave empty and Connect Xbox reports
# "not set up on this server" instead of failing halfway.
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
# TM11-56. Server-only base URL POST /api/xbox/import uses to reach the GameGPT API.
# Leave empty to use NEXT_PUBLIC_API_URL.
API_URL=

# --- Steam account linking (TM11-52 / REQ003) ---
# Server-only. Signs the short-lived cookie that carries a verified steamID64 from
# /api/steam/callback to POST /api/steam/link. At least 32 characters; generate one with
# `openssl rand -hex 32`. Leave empty and Connect Steam reports "not set up on this server".
STEAM_LINK_SECRET=
