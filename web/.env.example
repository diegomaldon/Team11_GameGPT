# Base URL of the GameGPT API. Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_URL=

# Fixture mode: set to 1 to run the frontend standalone with canned data and no
# running API (see web/lib/api/client.ts). Leave empty to hit NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_USE_FIXTURES=

# --- Supabase auth (E2 / REQ001) ---
# Copy this file to web/.env.local and fill both in, or lib/supabase.ts throws on import.
# Dashboard > Project Settings > API. Both values are safe in the browser: the anon key is
# public by design and RLS is what actually protects data. Never put the SERVICE ROLE key
# in a NEXT_PUBLIC_ variable — that one bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
