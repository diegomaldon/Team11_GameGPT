# ─────────────────────────────────────────────────────────────
# GameGPT environment. Copy to `.env` and fill in.
# NEVER commit a real .env. Every value here is intentionally empty.
# The skeleton runs with all keys blank by falling back to fixtures.
# ─────────────────────────────────────────────────────────────

# --- Core ---
# Injected by the platform at deploy time; used by GET /api/health.
GIT_COMMIT=
# Single seeded dev user (no real auth in the skeleton). UUID.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# --- Database (Supabase Postgres) ---
# postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# --- LLM generation ---
# Gemini is preferred when set, then Anthropic, then a deterministic stub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Embeddings (local Hugging Face sentence-transformers, 384 dims) ---
# Runs locally, no key. Downloads the model (~90 MB) on first use.
# Set EMBEDDING_STUB=1 to force the deterministic hash (skips torch).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Steam (IPlayerService/GetOwnedGames) ---
# Blank -> /api/library/sync falls back to seeded owned_games rows.
STEAM_API_KEY=

# --- Game catalog source (RAWG) ---
# Blank -> seed_games.py uses the committed JSON fixture.
RAWG_API_KEY=

# --- Observability (TM11-20) ---
# Error sink. Blank -> errors go to the structured stdout log only, which Render
# already collects, so a keyless local run and CI still work. Set it and both
# server errors and browser errors (via POST /api/client-error) land in Sentry.
# Server-side only on purpose: never expose this as NEXT_PUBLIC_.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# json (default) or text. Use text locally if raw JSON in a terminal annoys you;
# redaction applies either way.
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Web app ---
# Public base URL of the deployed API, consumed by the Next.js client.
NEXT_PUBLIC_API_URL=http://localhost:8000
