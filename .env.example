# ─────────────────────────────────────────────────────────────
# GameGPT environment. Copy to `.env` and fill in.
# NEVER commit a real .env. Every value here is intentionally empty.
# The skeleton runs with all keys blank by falling back to fixtures.
# ─────────────────────────────────────────────────────────────

# --- Core ---
# Injected by the platform at deploy time; used by GET /api/health.
GIT_COMMIT=
# Single seeded dev user (no real auth in the skeleton). UUID.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# --- Database (Supabase Postgres) ---
# postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# --- LLM generation (Anthropic) ---
# Blank -> LLMService falls back to a deterministic stub ranking.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Embeddings (OpenAI text-embedding-3-small, 1536 dims) ---
# Blank -> EmbeddingService falls back to a deterministic hashed vector.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Steam (IPlayerService/GetOwnedGames) ---
# Blank -> /api/library/sync falls back to seeded owned_games rows.
STEAM_API_KEY=

# --- Game catalog source (RAWG) ---
# Blank -> seed_games.py uses the committed JSON fixture.
RAWG_API_KEY=

# --- Web app ---
# Public base URL of the deployed API, consumed by the Next.js client.
NEXT_PUBLIC_API_URL=http://localhost:8000
