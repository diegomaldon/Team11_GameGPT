{
  "openapi": "3.1.0",
  "info": {
    "title": "GameGPT API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/recommend": {
      "post": {
        "tags": [
          "recommend"
        ],
        "summary": "Recommend",
        "operationId": "recommend_api_recommend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/feedback": {
      "post": {
        "tags": [
          "feedback"
        ],
        "summary": "Feedback",
        "operationId": "feedback_api_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/library": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "Get Library",
        "operationId": "get_library_api_library_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/sync": {
      "post": {
        "tags": [
          "library"
        ],
        "summary": "Sync Library",
        "operationId": "sync_library_api_library_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibrarySyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrarySyncResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FeedbackRequest": {
        "properties": {
          "query_id": {
            "type": "string",
            "format": "uuid",
            "title": "Query Id"
          },
          "game_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Game Id"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Denormalized so feedback is legible without a join."
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          },
          "vote": {
            "$ref": "#/components/schemas/Vote"
          }
        },
        "type": "object",
        "required": [
          "query_id",
          "title",
          "vote"
        ],
        "title": "FeedbackRequest",
        "description": "Body for POST /api/feedback. Returns 204, persists a row."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LibraryItem": {
        "properties": {
          "game_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Game Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "steam_appid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Steam Appid"
          },
          "platform": {
            "type": "string",
            "title": "Platform",
            "default": "steam"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "LibraryItem",
        "description": "One owned game in the user's cross-platform library."
      },
      "LibraryResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LibraryItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "LibraryResponse",
        "description": "Body returned from GET /api/library."
      },
      "LibrarySyncRequest": {
        "properties": {
          "steam_id": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Steam Id",
            "description": "Public steamID64, e.g. 76561197960287930."
          }
        },
        "type": "object",
        "required": [
          "steam_id"
        ],
        "title": "LibrarySyncRequest",
        "description": "Body for POST /api/library/sync. Pasted public steamID64."
      },
      "LibrarySyncResponse": {
        "properties": {
          "synced": {
            "type": "integer",
            "title": "Synced"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "'steam' for a real API call, 'seed' for the fallback."
          }
        },
        "type": "object",
        "required": [
          "synced",
          "source"
        ],
        "title": "LibrarySyncResponse",
        "description": "Result of a sync: how many rows landed and where they came from."
      },
      "RecommendRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query",
            "description": "Natural-language description of what to play."
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "RecommendRequest",
        "description": "Body for POST /api/recommend."
      },
      "RecommendResponse": {
        "properties": {
          "query_id": {
            "type": "string",
            "format": "uuid",
            "title": "Query Id",
            "description": "Persisted queries.id; echo it into feedback."
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            },
            "type": "array",
            "title": "Recommendations"
          }
        },
        "type": "object",
        "required": [
          "query_id",
          "query",
          "recommendations"
        ],
        "title": "RecommendResponse",
        "description": "Body returned from POST /api/recommend."
      },
      "Recommendation": {
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rank",
            "description": "1 is the best match."
          },
          "game_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Game Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "Why this fits the query. Never empty."
          },
          "steam_appid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Steam Appid"
          },
          "review_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Score"
          }
        },
        "type": "object",
        "required": [
          "rank",
          "title",
          "reason"
        ],
        "title": "Recommendation",
        "description": "One ranked recommendation returned to the client."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Vote": {
        "type": "string",
        "enum": [
          "up",
          "down"
        ],
        "title": "Vote"
      }
    }
  }
}