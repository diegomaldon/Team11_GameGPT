{
  "openapi": "3.1.0",
  "info": {
    "title": "GameGPT API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/recommend": {
      "post": {
        "tags": [
          "recommend"
        ],
        "summary": "Recommend",
        "operationId": "recommend_api_recommend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/feedback": {
      "post": {
        "tags": [
          "feedback"
        ],
        "summary": "Feedback",
        "operationId": "feedback_api_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/library": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "Get Library",
        "operationId": "get_library_api_library_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/sync": {
      "post": {
        "tags": [
          "library"
        ],
        "summary": "Sync Library",
        "operationId": "sync_library_api_library_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibrarySyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrarySyncResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/sync/jobs": {
      "post": {
        "tags": [
          "library"
        ],
        "summary": "Start Sync Job",
        "description": "Start a background sync, or return the one already running for this user.",
        "operationId": "start_sync_job_api_library_sync_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibrarySyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrarySyncJob"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/sync/jobs/{job_id}": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "Get Sync Job",
        "operationId": "get_sync_job_api_library_sync_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibrarySyncJob"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/csv/preview": {
      "post": {
        "tags": [
          "library"
        ],
        "summary": "Preview Csv Import",
        "description": "Per-row match results for a CSV. Writes nothing.",
        "operationId": "preview_csv_import_api_library_csv_preview_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CsvImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsvPreviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/csv/commit": {
      "post": {
        "tags": [
          "library"
        ],
        "summary": "Commit Csv Import",
        "description": "Re-check the CSV and add the matched rows the user kept.",
        "operationId": "commit_csv_import_api_library_csv_commit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CsvCommitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsvCommitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/games/search": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "Search Games",
        "description": "Catalogue games for the add-a-game autocomplete. Fewer than 2 characters returns none.",
        "operationId": "search_games_api_games_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "description": "Part of a game title.",
              "title": "Q"
            },
            "description": "Part of a game title."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 8,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameSearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/manual": {
      "post": {
        "tags": [
          "library"
        ],
        "summary": "Add Manual Game",
        "description": "Add one catalogue game to the library, stored with import_method MANUAL.",
        "operationId": "add_manual_game_api_library_manual_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualAddRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualAddResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CsvCommitRequest": {
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "xbox",
              "epic"
            ],
            "title": "Platform",
            "description": "Every row in the file is owned on this platform."
          },
          "csv_text": {
            "type": "string",
            "maxLength": 1000000,
            "title": "Csv Text",
            "description": "The whole file, header row first."
          },
          "excluded_rows": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 2000,
            "title": "Excluded Rows",
            "description": "Spreadsheet row numbers to leave out of the import."
          }
        },
        "type": "object",
        "required": [
          "platform",
          "csv_text"
        ],
        "title": "CsvCommitRequest",
        "description": "The same file again, plus the rows the user unticked during review."
      },
      "CsvCommitResponse": {
        "properties": {
          "added": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Added",
            "description": "Games newly added to the library."
          },
          "needs_review": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Needs Review",
            "description": "Rows sent to the review queue."
          },
          "skipped": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Skipped",
            "description": "Rows left out: unticked, already owned, duplicate, invalid."
          },
          "import_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Import Id",
            "description": "library_imports row for this upload."
          }
        },
        "type": "object",
        "required": [
          "added",
          "needs_review",
          "skipped"
        ],
        "title": "CsvCommitResponse",
        "description": "What a confirmed CSV import changed."
      },
      "CsvImportRequest": {
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "xbox",
              "epic"
            ],
            "title": "Platform",
            "description": "Every row in the file is owned on this platform."
          },
          "csv_text": {
            "type": "string",
            "maxLength": 1000000,
            "title": "Csv Text",
            "description": "The whole file, header row first."
          }
        },
        "type": "object",
        "required": [
          "platform",
          "csv_text"
        ],
        "title": "CsvImportRequest",
        "description": "A library CSV to review. The browser sends the file's text, not the file."
      },
      "CsvPreviewResponse": {
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "xbox",
              "epic"
            ],
            "title": "Platform"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/CsvRowResult"
            },
            "type": "array",
            "title": "Rows"
          },
          "matched": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Matched"
          },
          "needs_review": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Needs Review",
            "description": "Ambiguous plus unmatched rows."
          },
          "skipped": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Skipped",
            "description": "Already owned, duplicate or invalid rows."
          }
        },
        "type": "object",
        "required": [
          "platform",
          "rows",
          "matched",
          "needs_review",
          "skipped"
        ],
        "title": "CsvPreviewResponse",
        "description": "Per-row results of a CSV. Nothing has been written yet."
      },
      "CsvRowResult": {
        "properties": {
          "row_number": {
            "type": "integer",
            "minimum": 2.0,
            "title": "Row Number",
            "description": "As shown in a spreadsheet; row 1 is the header."
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/CsvRowStatus"
          },
          "game_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Game Id"
          },
          "game_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Game Title",
            "description": "The catalogue title the row matched."
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message",
            "description": "Why the row won't be added. Safe to show."
          }
        },
        "type": "object",
        "required": [
          "row_number",
          "title",
          "status"
        ],
        "title": "CsvRowResult",
        "description": "The review outcome for one CSV row."
      },
      "CsvRowStatus": {
        "type": "string",
        "enum": [
          "matched",
          "already_owned",
          "duplicate",
          "ambiguous",
          "unmatched",
          "invalid"
        ],
        "title": "CsvRowStatus"
      },
      "FeedbackRequest": {
        "properties": {
          "query_id": {
            "type": "string",
            "format": "uuid",
            "title": "Query Id"
          },
          "game_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Game Id"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Denormalized so feedback is legible without a join."
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          },
          "vote": {
            "$ref": "#/components/schemas/Vote"
          }
        },
        "type": "object",
        "required": [
          "query_id",
          "title",
          "vote"
        ],
        "title": "FeedbackRequest",
        "description": "Body for POST /api/feedback. Returns 204, persists a row."
      },
      "GameSearchResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/GameSearchResult"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "GameSearchResponse",
        "description": "Body returned from GET /api/games/search."
      },
      "GameSearchResult": {
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "title": "Game Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "steam_appid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Steam Appid"
          }
        },
        "type": "object",
        "required": [
          "game_id",
          "title"
        ],
        "title": "GameSearchResult",
        "description": "One autocomplete suggestion: a row from the games catalogue."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LibraryItem": {
        "properties": {
          "game_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Game Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "steam_appid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Steam Appid"
          },
          "platform": {
            "type": "string",
            "title": "Platform",
            "default": "steam"
          },
          "playtime_minutes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Playtime Minutes",
            "description": "Lifetime minutes played. 0 means owned but never played (TM11-46).",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "LibraryItem",
        "description": "One owned game in the user's cross-platform library."
      },
      "LibraryResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LibraryItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "LibraryResponse",
        "description": "Body returned from GET /api/library."
      },
      "LibrarySyncJob": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "state": {
            "$ref": "#/components/schemas/SyncJobState"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "default": 0
          },
          "processed": {
            "type": "integer",
            "title": "Processed",
            "description": "Titles handled so far, imported or failed.",
            "default": 0
          },
          "synced": {
            "type": "integer",
            "title": "Synced",
            "default": 0
          },
          "failed": {
            "items": {
              "$ref": "#/components/schemas/SyncFailure"
            },
            "type": "array",
            "title": "Failed"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Set when state is 'failed'."
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code",
            "description": "Stable code the UI branches on, e.g. 'steam_profile_private'. Set when state is 'failed'."
          },
          "import_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Import Id"
          },
          "matched": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched",
            "description": "Imported titles joined to a games row."
          },
          "unmatched": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unmatched",
            "description": "Titles with no games row; queued in unmatched_import_titles."
          },
          "match_rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Match Rate",
            "description": "matched / total, 0..1."
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "state",
          "started_at"
        ],
        "title": "LibrarySyncJob",
        "description": "A background library sync, polled by the UI for progress. TM11-49."
      },
      "LibrarySyncRequest": {
        "properties": {
          "steam_id": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Steam Id",
            "description": "Public steamID64, e.g. 76561197960287930."
          }
        },
        "type": "object",
        "required": [
          "steam_id"
        ],
        "title": "LibrarySyncRequest",
        "description": "Body for POST /api/library/sync. Pasted public steamID64."
      },
      "LibrarySyncResponse": {
        "properties": {
          "synced": {
            "type": "integer",
            "title": "Synced"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "'steam' for a real API call, 'seed' for the fallback."
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Titles the source returned (synced + failed).",
            "default": 0
          },
          "failed": {
            "items": {
              "$ref": "#/components/schemas/SyncFailure"
            },
            "type": "array",
            "title": "Failed",
            "description": "Per-title failures; they do not abort the run."
          },
          "import_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Import Id"
          },
          "matched": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched",
            "description": "Imported titles joined to a games row."
          },
          "unmatched": {
            "anyOf": [
